# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# Project data and runs (never in git)
/data/
.tmp/
duckdb-tmp/
/mlruns/
/tools/
/checkpoints/
/checkpoints/**/*.bin
/artifacts/**/*.bin
# Model weights never belong in git, wherever they are
*.onnx
*.safetensors
*.pt

# Local env
.env
.env.*
*.log

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Evaluation caches: they are a local speed-up, not a result. The reports and results.json next
# to them are the record and do belong in git.
/artifacts/eval/**/*.sqlite
/artifacts/eval/*.sqlite

# Generated embeddings: 715 MB of vectors that `rukh encoder embed` rebuilds from a checkpoint.
# They feed phase 2's position retrieval and belong on the Hub, never in git.
/artifacts/embeddings/
